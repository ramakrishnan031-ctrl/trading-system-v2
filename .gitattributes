# Normalise line endings: LF everywhere (the live VM is Ubuntu).
# CRLF is harmless in .py but breaks .sh, crontab and .env files.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.db binary
